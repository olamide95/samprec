# Optional. When set, enquiry and enrolment forms are POSTed here as JSON
# (e.g. a Zapier/Make webhook, Formspree endpoint, or your own API).
# When unset, forms fall back to opening the visitor's email client.
FORMS_WEBHOOK_URL=

# Canonical site URL used for SEO metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://samprecconsultants.com

# Optional. Online payment for Academy courses that have feeNaira set.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
